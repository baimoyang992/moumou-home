{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "产品中心"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "living",
        "dining",
        "bedroom",
        "office"
      ],
      "required": true
    },
    "description": {
      "type": "text"
    },
    "imageUrl": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "material": {
      "type": "string"
    },
    "dimensions": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
