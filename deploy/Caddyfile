{$SITE_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 1MB
  }
  reverse_proxy web:3000
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
  }
}
{$CMS_DOMAIN} {
  encode gzip
  request_body {
    max_size 21MB
  }
  reverse_proxy cms:1337
  header X-Content-Type-Options nosniff
}
